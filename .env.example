PORT=7000
ADDON_ID=community.ytdlp
YTDLP_VERSION=2026.08.19
# required — generate with: openssl rand -hex 16
ADDON_TOKEN=
# Optional: poToken provider (bgutil) — when set, yt-dlp requests proof-of-
# origin tokens from it (fixes YouTube throttling/bot-checks). In the
# TrueNAS compose this points at the internal bgutil service.
POT_PROVIDER_URL=
# Optional: poToken provider (bgutil) — when set, yt-dlp requests proof-of-
# origin tokens from it (fixes YouTube throttling/bot-checks). In the
# TrueNAS compose this points at the internal bgutil service.
POT_PROVIDER_URL=
